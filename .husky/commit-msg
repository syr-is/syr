#!/bin/sh
. "$(dirname -- "$0")/_/husky.sh"

# Validate conventional commit format: <type>(<scope>): <subject>
# See: https://gist.github.com/joshbuchea/6f47e86d2510bce28f8e7f42ae84c716
COMMIT_MSG_FILE=$1

# Ignore merge commits and "into" merges
if grep -qE " into |^Merge " "$COMMIT_MSG_FILE" 2>/dev/null; then
  exit 0
fi

COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")
CONVENTIONAL_REGEX='^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-zA-Z0-9_.-]+\))?(!)?: .+$'

if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_REGEX"; then
  echo ""
  echo "ERROR: Commit message does not follow Conventional Commits."
  echo ""
  echo "Format: <type>(<scope>): <subject>"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert"
  echo ""
  echo "Examples:"
  echo "  feat(auth): add login"
  echo "  fix(api): resolve timeout"
  echo ""
  exit 1
fi

exit 0
