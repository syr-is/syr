{
  "name": "syr-is",
  "version": "1.0.0",
  "description": "Syr monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "setup-signing": "sh scripts/setup-commit-signing.sh",
    "dev": "turbo dev",
    "dev:syr": "pnpm --filter @syr-is/syr dev",
    "dev:docs": "pnpm --filter @syr-is/docs dev",
    "dev:registry-api": "pnpm --filter @syr-is/registry-api start:dev",
    "dev:registry-client": "pnpm --filter @syr-is/registry-client dev",
    "dev:types": "pnpm --filter @syr-is/types dev",
    "dev:utils": "pnpm --filter @syr-is/utils dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "lint": "turbo lint",
    "check": "turbo check",
    "test": "turbo test",
    "cargo:format": "cargo fmt --manifest-path packages/rust/Cargo.toml --all && cargo fmt --manifest-path apps/syner/app/src-tauri/Cargo.toml",
    "cargo:format:check": "sh scripts/cargo-format-check.sh",
    "cargo:clippy": "sh scripts/cargo-clippy.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@syr-is/types": "workspace:*",
    "@syr-is/ui": "workspace:*"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "^2.8.0"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,svelte,json,css,scss,md,html,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@syr-is/types",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@smithy/types": "^4.11.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
