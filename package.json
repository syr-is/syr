{
  "name": "syr-is",
  "version": "1.0.0",
  "description": "SvelteKit monorepo",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "setup-signing": "sh scripts/setup-commit-signing.sh",
    "dev": "turbo dev",
    "dev:syr": "pnpm --filter @syr-is/syr dev",
    "dev:docs": "pnpm --filter @syr-is/docs dev",
    "dev:registry-api": "pnpm --filter @syr-is/registry-api start:dev",
    "dev:registry-client": "pnpm --filter @syr-is/registry-client dev",
    "dev:types": "pnpm --filter @syr-is/types dev",
    "build": "turbo build",
    "preview": "turbo preview",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "lint": "turbo lint",
    "check": "turbo check",
    "test": "turbo test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@syr-is/types": "workspace:*",
    "@syr-is/ui": "workspace:*"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.5.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@syr-is/types",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@smithy/types": "^4.11.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}