{
	"name": "@syr-is/resolver",
	"version": "0.0.1",
	"description": "DID resolver for did:syr — queries a registry and fetches DID Documents from providers",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint ."
	},
	"dependencies": {
		"@syr-is/crypto": "workspace:*",
		"@syr-is/did": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"prettier": "catalog:",
		"typescript": "^5.7.3",
		"typescript-eslint": "catalog:",
		"vitest": "^4.0.18"
	}
}
