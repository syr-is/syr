{
  "name": "@syr-is/crypto",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./aegis": {
      "types": "./dist/aegis.d.ts",
      "import": "./dist/aegis.js",
      "default": "./dist/aegis.js"
    },
    "./sigil": {
      "types": "./dist/sigil.d.ts",
      "import": "./dist/sigil.js",
      "default": "./dist/sigil.js"
    },
    "./wasm": {
      "types": "./dist/wasm/web/syr_crypto_wasm.d.ts",
      "node": "./dist/wasm/node/syr_crypto_wasm_esm.mjs",
      "import": "./dist/wasm/web/syr_crypto_wasm.js",
      "default": "./dist/wasm/web/syr_crypto_wasm.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run build:wasm && tsc",
    "build:wasm": "pnpm run build:wasm:web && pnpm run build:wasm:node && pnpm run build:wasm:node:esm",
    "build:wasm:web": "cd ../../rust/syr-crypto-wasm && wasm-pack build --target web --out-dir ../../ts/crypto/dist/wasm/web",
    "build:wasm:node": "cd ../../rust/syr-crypto-wasm && wasm-pack build --target nodejs --out-dir ../../ts/crypto/dist/wasm/node",
    "build:wasm:node:esm": "node scripts/generate-node-esm-wrapper.mjs",
    "dev": "tsc --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "espree": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.4.0"
  }
}
