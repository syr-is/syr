{
  "name": "@syr-is/crypto",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pem": {
      "node": {
        "types": "./dist/pem.d.ts",
        "import": "./dist/pem.js",
        "default": "./dist/pem.js"
      },
      "default": {
        "types": "./dist/pem.browser.d.ts",
        "import": "./dist/pem.browser.js",
        "default": "./dist/pem.browser.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && eslint ."
  },
  "dependencies": {
    "@noble/ed25519": "^2.2.3",
    "@scure/base": "^1.2.4",
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.4.0"
  }
}
